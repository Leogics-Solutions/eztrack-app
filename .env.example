# Backend API Configuration
# Set the base URL for the backend API
# Defaults to http://localhost:8000 if not set
NEXT_PUBLIC_API_URL=http://localhost:8000

# Agent service (FastAPI brain, separate from Platform API)
# Server-side proxy target for /agent-service/* rewrites (default :8800)
AGENT_SERVICE_URL=http://127.0.0.1:8800
# Optional: call agent directly from browser (skip proxy). Leave unset to use /agent-service proxy.
# NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8800

# Alternative: You can also use NEXT_PUBLIC_URL (for backward compatibility)
# NEXT_PUBLIC_URL=http://localhost:8000

# Note: Application settings (like Business Central integration enable/disable)
# are managed through the Settings API endpoint and stored in the backend database.
# These settings can be configured via the Settings page in the application UI.




