# Supply the real production API origin through the existing NEXT_PUBLIC_API_URL.
# These public settings must be present when building Next.js.
NEXT_PUBLIC_LOCAL_CONNECTOR_ENABLED=false
# JI-AUTO production organization.
NEXT_PUBLIC_LOCAL_CONNECTOR_ORGANIZATION_ID=76
# Optional: HTTPS download URL for the signed installer.
NEXT_PUBLIC_CONNECTOR_INSTALLER_URL=
